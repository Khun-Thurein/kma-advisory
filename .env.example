# Public site URL. Use the final HTTPS domain in production.
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Keep false until all launch checks and business details are complete.
NEXT_PUBLIC_ALLOW_INDEXING=false

# Optional until the Search Console account exists.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Contact and conversion settings. Replace every placeholder before launch.
NEXT_PUBLIC_CONTACT_EMAIL=khun@kmaadvisory.com.au
# Optional. Leave empty so Book Now opens /contact.
NEXT_PUBLIC_BOOKING_URL=
